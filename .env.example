# Copy to .env (never committed) and change every password.
ORTHANC_URL=http://127.0.0.1:8042
ORTHANC_USER=aiml02
ORTHANC_PASSWORD=change-me
RESULTS_DB_PORT=5434
RESULTS_DB_PASSWORD=change-me

# Inference worker (docker-compose.worker.yml): checkpoint files on this machine, outside the
# repository, mounted read-only. Never copy them into the repository or the image.
CLASSIFIER_CHECKPOINT=C:/aiml02-checkpoints/epoch_003.pt
SEGMENTATION_CHECKPOINT=C:/aiml02-checkpoints/epoch_180.pt
WORKER_RESULTS_DIR=./results/worker

# Viewer API (docker-compose.api.yml), on 127.0.0.1 only.
API_PORT=8000
