# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/

# Secrets and local configuration
.env
.env.*
!.env.example
*.pem
*.key
kaggle.json

# All local data (only the README and DVC pointer files are tracked).
# Do not use /data/* or /data/*/ here: DVC then stops seeing data/*.dvc, and `dvc push` says
# "Everything is up to date" without pushing anything (tests/test_repo_setup.py checks this).
/data/manifests/
/data/processed/
/data/splits/
/data/seg_splits/
data/raw/
data/cache/
/data/**/*.csv
/data/**/*.txt
/data/**/*.zip
/data/**/*.png

# Medical image formats, wherever they end up
*.dcm
*.nii
*.nii.gz
*.npz

# Generated ML artifacts
mlruns/
mlflow.db
artifacts/
checkpoints/
/models/
*.pkl
*.joblib
*.pt
*.pth
*.onnx
*.parquet
.ipynb_checkpoints/

# Editors and operating systems
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs and temporary files
*.log
tmp/
temp/
