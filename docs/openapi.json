{
  "components": {
    "schemas": {
      "Body_upload_api_uploads_post": {
        "properties": {
          "file": {
            "contentMediaType": "application/octet-stream",
            "title": "File",
            "type": "string"
          },
          "uploader": {
            "title": "Uploader",
            "type": "string"
          }
        },
        "required": [
          "file",
          "uploader"
        ],
        "title": "Body_upload_api_uploads_post",
        "type": "object"
      },
      "ErrorBody": {
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          }
        },
        "required": [
          "detail"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ReviewIn": {
        "additionalProperties": false,
        "description": "A review as the browser sends it. Names are not verified (there is no login).",
        "properties": {
          "comment": {
            "anyOf": [
              {
                "maxLength": 2000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Comment"
          },
          "decision": {
            "enum": [
              "approve",
              "reject"
            ],
            "title": "Decision",
            "type": "string"
          },
          "inference_result_id": {
            "title": "Inference Result Id",
            "type": "integer"
          },
          "reviewer": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Reviewer",
            "type": "string"
          },
          "submit_token": {
            "format": "uuid",
            "title": "Submit Token",
            "type": "string"
          }
        },
        "required": [
          "decision",
          "reviewer",
          "submit_token",
          "inference_result_id"
        ],
        "title": "ReviewIn",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
